# Supabase 프로젝트 설정 (Settings → API 에서 확인)
# 이 파일을 .env 로 복사해서 실제 값을 채워 넣으세요. .env 는 커밋되지 않습니다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 네이버 지도 (NCP → Maps) Client ID.
# 지도 JS는 브라우저에서 직접 부르므로 이 값은 공개되는 것이 정상이고,
# 서비스 URL 등록으로 보호한다. 비워두면 OpenStreetMap으로 그려진다.
# ⚠️ 지역 검색용 NAVER_CLIENT_SECRET 은 여기에 절대 넣지 마세요 (Supabase 시크릿 전용).
VITE_NAVER_MAP_CLIENT_ID=
